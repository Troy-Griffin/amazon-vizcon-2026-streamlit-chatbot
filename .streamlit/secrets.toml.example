#
# Get a free Gemini API key at https://aistudio.google.com/apikey
#
# On Streamlit Community Cloud, don't upload this file at all -- instead
# paste the same key=value pairs into your app's "Secrets" settings panel
# in the Streamlit Cloud dashboard.

GEMINI_API_KEY = "your-gemini-api-key-here"
